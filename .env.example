# ── App ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
APP_TIMEZONE=Asia/Jakarta

# ── Telegram (wajib) ───────────────────────────────────
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# User ID Telegram numerik Anda (cek via @userinfobot). Hanya user ini yang dilayani bot.
TELEGRAM_ALLOWED_USER_ID=

# ── Database (wajib) ───────────────────────────────────
# PostgreSQL lokal macOS (Homebrew/Postgres.app): ganti USERNAME dengan user macOS Anda (`whoami`).
# Jika memakai Docker Compose: postgresql://postgres:postgres@localhost:5433/crypto_analyst
DATABASE_URL=postgresql://USERNAME@localhost:5432/crypto_analyst
# Opsional: database terpisah untuk integration test (tests/integration)
TEST_DATABASE_URL=postgresql://USERNAME@localhost:5432/crypto_analyst_test

# ── AI (opsional) ──────────────────────────────────────
# Jika kosong, analisis deterministik tetap jalan; penjelasan AI dinonaktifkan.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Indodax ────────────────────────────────────────────
INDODAX_PUBLIC_BASE_URL=https://indodax.com
# Tidak digunakan. MVP hanya memakai Public API; biarkan kosong.
INDODAX_API_KEY=
INDODAX_SECRET_KEY=
